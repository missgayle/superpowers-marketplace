---
interface Resource {
  id: string;
  title: { en: string; es: string };
  description: { en: string; es: string };
  format: string;
  type: string;
  stage: string[];
  audience: string[];
  source: string;
  url: string;
  scienceTags: string[];
}

interface Props {
  resource: Resource;
  lang: string;
}

const { resource, lang } = Astro.props;

const title = resource.title[lang as 'en' | 'es'] ?? resource.title.en;
const description = resource.description[lang as 'en' | 'es'] ?? resource.description.en;

const formatLabels: Record<string, { en: string; es: string }> = {
  read:   { en: 'Read',   es: 'Leer'    },
  listen: { en: 'Listen', es: 'Escuchar' },
  watch:  { en: 'Watch',  es: 'Ver'      },
};

const stageLabels: Record<string, { en: string; es: string }> = {
  acute:     { en: 'Acute',     es: 'Aguda'       },
  'long-term': { en: 'Long-term', es: 'A largo plazo' },
};

const formatLabel = formatLabels[resource.format]?.[lang as 'en' | 'es'] ?? resource.format;

// Build a stage display string
const stageDisplay = (() => {
  const stages = resource.stage ?? [];
  if (stages.includes('acute') && stages.includes('long-term')) {
    return lang === 'es' ? 'Ambas' : 'Both';
  }
  if (stages.length === 1) {
    return stageLabels[stages[0]]?.[lang as 'en' | 'es'] ?? stages[0];
  }
  return stages.map(s => stageLabels[s]?.[lang as 'en' | 'es'] ?? s).join(', ');
})();
---

<article
  class="resource-card"
  data-format={resource.format}
  data-stage={resource.stage?.join(',')}
  data-audience={resource.audience?.join(',')}
>
  <div class="card-top">
    <span class={`format-badge format-${resource.format}`}>{formatLabel}</span>
    <span class="stage-badge">{stageDisplay}</span>
  </div>

  <h3 class="card-title">
    <a href={resource.url} target="_blank" rel="noopener noreferrer">
      {title}
    </a>
  </h3>

  <p class="card-description">{description}</p>

  <p class="card-source">{resource.source}</p>
</article>

<style>
  .resource-card {
    background-color: var(--color-cream);
    border: 1px solid var(--color-sage-light);
    border-radius: 10px;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: box-shadow 0.2s ease;
  }

  .resource-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.10);
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .format-badge,
  .stage-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2em 0.6em;
    border-radius: 4px;
  }

  .format-read {
    background-color: var(--color-sage-light);
    color: var(--color-charcoal);
  }

  .format-listen {
    background-color: var(--color-gold-light);
    color: var(--color-charcoal);
  }

  .format-watch {
    background-color: var(--color-clay-light);
    color: var(--color-charcoal);
  }

  .stage-badge {
    background-color: transparent;
    border: 1px solid var(--color-charcoal-light);
    color: var(--color-charcoal-light);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: 600;
    line-height: var(--line-height-heading);
    margin-top: var(--space-xs);
  }

  .card-title a {
    color: var(--color-charcoal);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--color-clay);
    text-decoration: underline;
  }

  .card-description {
    font-size: var(--font-size-sm);
    color: var(--color-charcoal);
    line-height: 1.6;
    flex: 1;
  }

  .card-source {
    font-size: var(--font-size-sm);
    color: var(--color-charcoal-light);
    font-style: italic;
    margin-top: auto;
  }
</style>
