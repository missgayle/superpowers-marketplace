---
import BaseLayout from '../../layouts/BaseLayout.astro';
const lang = 'en';
---

<BaseLayout
  title="Activist Resiliency"
  description="Evidence-based tools for activists, organizers, and movements — grounded in neuroscience and contemplative wisdom."
  lang={lang}
>
  <section class="hero">
    <div class="container hero-inner">
      <h1 class="hero-heading">You don't have to carry this alone.</h1>
      <p class="hero-subtitle">
        Evidence-based tools for activists, organizers, and movements — grounded in neuroscience and contemplative wisdom.
      </p>
    </div>
  </section>

  <section class="doorways">
    <div class="container doorways-grid">
      <a href="/en/crisis" class="doorway-card doorway-crisis">
        <h2 class="doorway-title">I Need Help Now</h2>
        <p class="doorway-description">
          Grounding practices, breathing exercises, and immediate support for acute stress, overwhelm, or crisis.
        </p>
      </a>

      <a href="/en/resilience" class="doorway-card doorway-resilience">
        <h2 class="doorway-title">Build Resilience</h2>
        <p class="doorway-description">
          Long-term practices, tools, and frameworks for sustainable activism — for yourself, your team, and your organization.
        </p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-2xl) 0 var(--space-xl);
    text-align: center;
  }

  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--color-charcoal);
    line-height: 1.2;
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-charcoal);
    opacity: 0.8;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .doorways {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .doorways-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  @media (max-width: 639px) {
    .doorways-grid {
      grid-template-columns: 1fr;
    }
  }

  .doorway-card {
    display: block;
    border-radius: 12px;
    padding: var(--space-xl) var(--space-lg);
    text-decoration: none;
    color: white;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .doorway-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    color: white;
  }

  .doorway-crisis {
    background: linear-gradient(135deg, var(--color-clay-light), var(--color-clay));
  }

  .doorway-resilience {
    background: linear-gradient(135deg, var(--color-sage-light), var(--color-sage));
  }

  .doorway-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin-bottom: var(--space-sm);
    color: white;
  }

  .doorway-description {
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: white;
    opacity: 0.92;
  }
</style>
