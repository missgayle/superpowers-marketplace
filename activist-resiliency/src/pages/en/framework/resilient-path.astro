    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-charcoal);
    line-height: 1.2;
    margin-bottom: var(--space-md);
  }

  .page-intro {
    font-size: var(--font-size-lg);
