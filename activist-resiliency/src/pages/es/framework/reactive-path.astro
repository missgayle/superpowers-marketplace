  .outcome-item p { font-size: var(--font-size-sm); color: var(--color-charcoal); line-height: 1.7; opacity: 0.85; }
  .hope-section { margin-bottom: var(--space-xl); padding: var(--space-xl); background: linear-gradient(135deg, #EEF4EC, #F8EDE9); border-radius: 12px; }
