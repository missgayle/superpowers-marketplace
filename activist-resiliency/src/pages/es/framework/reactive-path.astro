  .behavior-title { font-family: var(--font-heading); font-size: var(--font-size-base); font-weight: 700; color: var(--color-charcoal); margin-bottom: var(--space-xs); }
  .behavior-body { font-size: var(--font-size-sm); color: var(--color-charcoal); line-height: 1.7; }
  .outcomes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xl); margin-top: var(--space-lg); }
  @media (max-width: 767px) { .outcomes-grid { grid-template-columns: 1fr; } }
  .outcomes-col-heading { font-family: var(--font-heading); font-size: var(--font-size-base); font-weight: 700; color: var(--color-clay); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-md); padding-bottom: var(--space-xs); border-bottom: 2px solid var(--color-clay-light); }
  .outcome-item { margin-bottom: var(--space-md); }
