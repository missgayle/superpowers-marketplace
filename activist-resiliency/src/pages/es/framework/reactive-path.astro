  .hope-heading { font-family: var(--font-heading); font-size: var(--font-size-xl); font-weight: 700; color: var(--color-charcoal); margin-bottom: var(--space-md); }
  .hope-body { font-size: var(--font-size-base); color: var(--color-charcoal); line-height: 1.8; margin-bottom: var(--space-md); }
  .hope-links { display: flex; gap: var(--space-md); flex-wrap: wrap; margin-top: var(--space-lg); }
  .hope-link { display: inline-block; font-size: var(--font-size-sm); font-weight: 600; text-decoration: none; padding: 0.6rem 1.25rem; border-radius: 6px; transition: opacity 0.2s ease; }
  .hope-link:hover { opacity: 0.85; }
  .emergency-link { background-color: var(--color-clay); color: white; }
  .primary-link { background-color: var(--color-sage); color: white; }
  .secondary-link { background-color: transparent; color: var(--color-charcoal); border: 1px solid var(--color-charcoal-light); }
  .credits-section { padding-top: var(--space-lg); border-top: 1px solid var(--color-clay-light); max-width: 72ch; }
  .credits-text { font-size: var(--font-size-sm); color: var(--color-charcoal); opacity: 0.65; line-height: 1.6; }
</style>
